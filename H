// Arrange
var ids = new List<string> { "id1", "id2" };

// 1. Mock the individual user request (for GetHttpRequestMessage)
var mockUserRequest = new Mock<IUserRequest>();
mockUserRequest
    .Setup(r => r.Select(It.IsAny<Expression<Func<User, object>>>()))
    .Returns(mockUserRequest.Object);
mockUserRequest
    .Setup(r => r.GetHttpRequestMessage())
    .Returns(new HttpRequestMessage(HttpMethod.Get, "https://graph.microsoft.com/v1.0/users/id1"));

// 2. Mock Users[id] to return the request builder
var mockUserRequestBuilder = new Mock<IUserRequestBuilder>();
mockUserRequestBuilder
    .Setup(b => b.Request())
    .Returns(mockUserRequest.Object);

// 3. Mock _graphClient.Users[id]
var mockUsersCollectionRequestBuilder = new Mock<IUsersCollectionRequestBuilder>();
mockUsersCollectionRequestBuilder
    .Setup(u => u[It.IsAny<string>()])
    .Returns(mockUserRequestBuilder.Object);

// 4. Mock BatchRequestContent (upnBatch)
var mockBatchRequestContent = new Mock<BatchRequestContent>();
mockBatchRequestContent
    .Setup(b => b.AddBatchRequestStep(It.IsAny<HttpRequestMessage>()))
    .Returns("stepId1"); // return a fake stepId

// 5. Mock the batch response
var mockBatchResponseContent = new Mock<BatchResponseContent>();

// Simulate per-step response
var user = new User
{
    GivenName = "Test",
    Surname = "User",
    DisplayName = "Test User",
    Mail = "user@example.com"
};

mockBatchResponseContent
    .Setup(r => r.GetResponseByIdAsync<User>(It.IsAny<string>()))
    .ReturnsAsync(user);

// 6. Mock _graphClient.Batch.Request().PostAsync(...)
var mockBatchRequest = new Mock<IBatchRequest>();
mockBatchRequest
    .Setup(r => r.PostAsync(
        It.IsAny<BatchRequestContent>(),
        It.IsAny<CancellationToken>()))
    .ReturnsAsync(mockBatchResponseContent.Object);

var mockBatchRequestBuilder = new Mock<IBatchRequestBuilder>();
mockBatchRequestBuilder
    .Setup(b => b.Request())
    .Returns(mockBatchRequest.Object);

// 7. Wire everything to the graph client
var mockGraphClient = new Mock<IGraphServiceClient>();
mockGraphClient.Setup(c => c.Users).Returns(mockUsersCollectionRequestBuilder.Object);
mockGraphClient.Setup(c => c.Batch).Returns(mockBatchRequestBuilder.Object);



[Fact]
public async Task GetUsers_Batch_ShouldReturnUsers()
{
    // Arrange (setup above)
    var sut = new YourService(mockGraphClient.Object);

    // Act
    var result = await sut.GetUsersByIds(ids);

    // Assert
    mockBatchRequest.Verify(
        r => r.PostAsync(
            It.IsAny<BatchRequestContent>(),
            It.IsAny<CancellationToken>()),
        Times.Once);

    Assert.NotNull(result);
    Assert.Equal(ids.Count, result.Count);
}