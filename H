import { CanDeactivateFn } from '@angular/router';

export interface HasUnsavedChanges {
  hasUnsavedChanges(): boolean;
}

export const unsavedChangesGuard: CanDeactivateFn<HasUnsavedChanges> = (component) => {
  if (component.hasUnsavedChanges()) {
    return confirm('You have unsaved changes. Do you really want to leave?');
  }
  return true;
};


import { Component, HostListener, OnDestroy, OnInit } from '@angular/core';
import { FormBuilder, FormGroup, ReactiveFormsModule } from '@angular/forms';
import { Router } from '@angular/router';
import { HasUnsavedChanges } from './unsaved-changes.guard';

@Component({
  selector: 'app-my-form',
  standalone: true,
  imports: [ReactiveFormsModule],
  template: `
    <form [formGroup]="form">
      <!-- your form fields -->
    </form>
  `,
})
export class MyFormComponent implements HasUnsavedChanges, OnInit, OnDestroy {
  form: FormGroup;
  private skipGuard = false;
  private navigatingBack = false;
  private restoringBarrier = false;
  private boundPopState = this.handlePopState.bind(this);

  constructor(private fb: FormBuilder, private router: Router) {
    this.form = this.fb.group({
      // your fields
    });
  }

  ngOnInit(): void {
    history.pushState(null, '', location.href);
    window.addEventListener('popstate', this.boundPopState);
  }

  ngOnDestroy(): void {
    window.removeEventListener('popstate', this.boundPopState);
  }

  hasUnsavedChanges(): boolean {
    return !this.skipGuard && this.form.dirty;
  }

  @HostListener('window:beforeunload', ['$event'])
  onBeforeUnload(event: BeforeUnloadEvent): void {
    if (this.form.dirty) {
      event.preventDefault();
    }
  }

  onSave(): void {
    // ... save logic
    this.form.markAsPristine();
    // OR for programmatic navigation:
    this.skipGuard = true;
    this.router.navigate(['/success']);
  }

  private handlePopState(): void {
    if (this.navigatingBack || this.restoringBarrier) {
      this.restoringBarrier = false;
      return;
    }

    if (this.form.dirty) {
      const confirmed = confirm('You have unsaved changes. Do you really want to leave?');
      if (confirmed) {
        this.navigatingBack = true;
        this.skipGuard = true;
        history.back();
      } else {
        this.restoringBarrier = true;
        history.forward();
      }
    } else {
      this.navigatingBack = true;
      history.back();
    }
  }
}


{
  path: 'my-form',
  loadComponent: () => import('./my-form.component').then(m => m.MyFormComponent),
  canDeactivate: [unsavedChangesGuard],
}
