public async Task<List<User>> GetUsersAsync(List<string> ids)
{
    var result = new List<User>();

    foreach (var chunk in ids.Chunk(20))
    {
        var fetched = await FetchChunkAsync(chunk.ToList());
        result.AddRange(fetched);
    }

    return result;
}

private async Task<List<User>> FetchChunkAsync(List<string> ids)
{
    var result = new List<User>();
    var fallbackIds = new List<string>();

    // Batch 1: UPN direct lookup
    var upnBatch = new BatchRequestContent();
    var upnStepMap = new Dictionary<string, string>();

    foreach (var id in ids)
    {
        var stepId = upnBatch.AddBatchRequestStep(
            graphClient.Users[id]
                .Request()
                .Select(u => new { u.Id, u.DisplayName, u.Mail, u.UserPrincipalName })
                .GetHttpRequestMessage());

        upnStepMap[stepId] = id;
    }

    var upnResponse = await graphClient.Batch.Request().PostAsync(upnBatch);

    foreach (var (stepId, id) in upnStepMap)
    {
        try
        {
            result.Add(await upnResponse.GetResponseByIdAsync<User>(stepId));
        }
        catch (ServiceException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            fallbackIds.Add(id);
        }
    }

    if (!fallbackIds.Any()) return result;

    // Batch 2: Mail filter fallback
    var mailBatch = new BatchRequestContent();
    var mailStepMap = new Dictionary<string, string>();

    foreach (var id in fallbackIds)
    {
        var stepId = mailBatch.AddBatchRequestStep(
            graphClient.Users
                .Request()
                .Header("ConsistencyLevel", "eventual")
                .Filter($"mail eq '{id}'")
                .Top(1)
                .Select(u => new { u.Id, u.DisplayName, u.Mail, u.UserPrincipalName })
                .GetHttpRequestMessage());

        mailStepMap[stepId] = id;
    }

    var mailResponse = await graphClient.Batch.Request().PostAsync(mailBatch);

    foreach (var (stepId, id) in mailStepMap)
    {
        try
        {
            var response = await mailResponse.GetResponseByIdAsync<UserCollectionResponse>(stepId);
            var user = response?.Value?.FirstOrDefault();
            if (user != null) result.Add(user);
        }
        catch (ServiceException ex)
        {
            _logger.LogWarning("User not found for {Id}: {Message}", id, ex.Message);
        }
    }

    return result;
}
