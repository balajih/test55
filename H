import { Component, HostListener, OnDestroy, OnInit } from '@angular/core';
import { FormBuilder, FormGroup, ReactiveFormsModule } from '@angular/forms';
import { Router } from '@angular/router';
import { HasUnsavedChanges } from './unsaved-changes.guard';

@Component({
  selector: 'app-my-form',
  standalone: true,
  imports: [ReactiveFormsModule],
  template: `
    <form [formGroup]="form">
      <!-- your form fields -->
    </form>
  `,
})
export class MyFormComponent implements HasUnsavedChanges, OnInit, OnDestroy {
  form: FormGroup;
  private skipGuard = false;
  private navigatingBack = false;
  private restoringPosition = false;
  private boundPopState = this.handlePopState.bind(this);

  constructor(private fb: FormBuilder, private router: Router) {
    this.form = this.fb.group({
      // your fields
    });
  }

  ngOnInit(): void {
    window.addEventListener('popstate', this.boundPopState, true); // capture phase
  }

  ngOnDestroy(): void {
    window.removeEventListener('popstate', this.boundPopState, true);
  }

  hasUnsavedChanges(): boolean {
    return !this.skipGuard && this.form.dirty;
  }

  @HostListener('window:beforeunload', ['$event'])
  onBeforeUnload(event: BeforeUnloadEvent): void {
    if (this.form.dirty) {
      event.preventDefault();
    }
  }

  onSave(): void {
    // ... save logic
    this.form.markAsPristine();
    // OR for programmatic navigation:
    this.skipGuard = true;
    this.router.navigate(['/success']);
  }

  private handlePopState(event: PopStateEvent): void {
    // Let the confirmed back-navigation reach Angular
    if (this.navigatingBack) return;

    // Suppress the restore-popstate so Angular doesn't see it
    if (this.restoringPosition) {
      event.stopImmediatePropagation();
      this.restoringPosition = false;
      return;
    }

    // Clean form — let Angular handle normally
    if (!this.form.dirty) return;

    // Dirty form — intercept before Angular sees it
    event.stopImmediatePropagation();

    const confirmed = confirm('You have unsaved changes. Do you really want to leave?');
    if (confirmed) {
      this.navigatingBack = true;
      this.skipGuard = true;
      history.back(); // next popstate reaches Angular (navigatingBack skips our handler)
    } else {
      this.restoringPosition = true;
      history.go(1); // move pointer forward to form — no entries added
    }
  }
}
