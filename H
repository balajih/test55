import { TestBed } from '@angular/core/testing';
import { ActivatedRouteSnapshot, RouterStateSnapshot } from '@angular/router';
import { unsavedChangesGuard, HasUnsavedChanges } from './unsaved-changes.guard';

describe('unsavedChangesGuard', () => {
  let mockComponent: jasmine.SpyObj<HasUnsavedChanges>;

  const runGuard = (component: any): boolean =>
    TestBed.runInInjectionContext(() =>
      unsavedChangesGuard(
        component,
        {} as ActivatedRouteSnapshot,
        {} as RouterStateSnapshot,
        {} as RouterStateSnapshot
      )
    ) as boolean;

  beforeEach(() => {
    TestBed.configureTestingModule({});
    mockComponent = jasmine.createSpyObj<HasUnsavedChanges>('HasUnsavedChanges', [
      'hasUnsavedChanges',
      'confirmNavigation'
    ]);
  });

  describe('when component is null', () => {
    it('should return true and allow navigation', () => {
      expect(runGuard(null)).toBeTrue();
    });
  });

  describe('when form is not dirty', () => {
    it('should return true and allow navigation without showing dialog', () => {
      spyOn(window, 'confirm');
      mockComponent.hasUnsavedChanges.and.returnValue(false);

      expect(runGuard(mockComponent)).toBeTrue();
      expect(window.confirm).not.toHaveBeenCalled();
    });
  });

  describe('when form is dirty', () => {
    beforeEach(() => {
      mockComponent.hasUnsavedChanges.and.returnValue(true);
    });

    it('should show confirm dialog with correct message', () => {
      spyOn(window, 'confirm').and.returnValue(true);

      runGuard(mockComponent);

      expect(window.confirm).toHaveBeenCalledOnceWith(
        'You have unsaved changes. Do you really want to leave?'
      );
    });

    describe('and user confirms', () => {
      beforeEach(() => spyOn(window, 'confirm').and.returnValue(true));

      it('should return true and allow navigation', () => {
        expect(runGuard(mockComponent)).toBeTrue();
      });

      it('should call confirmNavigation', () => {
        runGuard(mockComponent);

        expect(mockComponent.confirmNavigation).toHaveBeenCalledTimes(1);
      });
    });

    describe('and user cancels', () => {
      beforeEach(() => spyOn(window, 'confirm').and.returnValue(false));

      it('should return false and block navigation', () => {
        expect(runGuard(mockComponent)).toBeFalse();
      });

      it('should not call confirmNavigation', () => {
        runGuard(mockComponent);

        expect(mockComponent.confirmNavigation).not.toHaveBeenCalled();
      });
    });
  });
});