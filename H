public class RequestCache
{
    private readonly IHttpContextAccessor _httpContextAccessor;

    public RequestCache(IHttpContextAccessor accessor) 
        => _httpContextAccessor = accessor;

    private IDictionary<object, object?> Items =>
        _httpContextAccessor.HttpContext!.Items;

    public T? Get<T>(string key) =>
        Items.TryGetValue(key, out var value) ? (T?)value : default;

    public void Set<T>(string key, T value) =>
        Items[key] = value;

    public async Task<T> GetOrSetAsync<T>(string key, Func<Task<T>> factory)
    {
        if (Items.TryGetValue(key, out var existing))
            return (T)existing!;

        var value = await factory();
        Items[key] = value;
        return value;
    }
}

builder.Services.AddHttpContextAccessor();
builder.Services.AddScoped<RequestCache>();