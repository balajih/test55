// IRequestCache.cs
public interface IRequestCache
{
    T GetOrSet<T>(string key, Func<T> factory);
    void Set<T>(string key, T value);
    bool TryGet<T>(string key, out T? value);
    void Remove(string key);
}

// RequestCache.cs
public sealed class RequestCache : IRequestCache
{
    private readonly ConcurrentDictionary<string, Lazy<object?>> _cache = new();

    public T GetOrSet<T>(string key, Func<T> factory)
    {
        // Lazy<T> ensures the factory runs exactly once per key,
        // even if multiple threads call GetOrSet simultaneously.
        var lazy = _cache.GetOrAdd(key, _ => new Lazy<object?>(() => factory(), LazyThreadSafetyMode.ExecutionAndPublication));

        return (T)lazy.Value!;
    }

    public void Set<T>(string key, T value)
    {
        _cache[key] = new Lazy<object?>(value);
    }

    public bool TryGet<T>(string key, out T? value)
    {
        if (_cache.TryGetValue(key, out var lazy))
        {
            value = (T)lazy.Value!;
            return true;
        }

        value = default;
        return false;
    }

    public void Remove(string key)
    {
        _cache.TryRemove(key, out _);
    }
}