using System.Collections.Concurrent;

namespace YourProject.Caching;

/// <summary>
/// Thread-safe cache scoped to a single HTTP request.
/// Registered as Scoped, so it is created per request and disposed automatically.
/// </summary>
public sealed class RequestCache : IRequestCache, IDisposable
{
    private readonly ConcurrentDictionary<string, Lazy<object?>> _cache = new();
    private volatile bool _disposed;

    /// <inheritdoc />
    public T? Get<T>(string key)
    {
        ThrowIfDisposed();

        if (_cache.TryGetValue(key, out var lazy))
        {
            return (T?)lazy.Value;
        }

        return default;
    }

    /// <inheritdoc />
    /// <remarks>
    /// The factory runs at most once per key, even if multiple threads call this simultaneously.
    /// </remarks>
    public T GetOrAdd<T>(string key, Func<T> factory)
    {
        ThrowIfDisposed();
        ArgumentNullException.ThrowIfNull(factory);

        var lazy = _cache.GetOrAdd(key, _ => new Lazy<object?>(
            () => factory(),
            LazyThreadSafetyMode.ExecutionAndPublication));

        return (T)lazy.Value!;
    }

    /// <inheritdoc />
    /// <remarks>
    /// Uses a Lazy wrapper so only one thread executes the async factory per key.
    /// The Task itself is cached, so subsequent callers await the same result.
    /// </remarks>
    public async Task<T> GetOrAddAsync<T>(string key, Func<Task<T>> factory)
    {
        ThrowIfDisposed();
        ArgumentNullException.ThrowIfNull(factory);

        var lazy = _cache.GetOrAdd(key, _ => new Lazy<object?>(
            () => factory(),
            LazyThreadSafetyMode.ExecutionAndPublication));

        // The stored value is a Task<T>; await it.
        return await ((Task<T>)lazy.Value!).ConfigureAwait(false);
    }

    /// <inheritdoc />
    public void Set<T>(string key, T value)
    {
        ThrowIfDisposed();

        // Wrap in an already-evaluated Lazy so the value is immediately available.
        var lazy = new Lazy<object?>(value);
        _cache[key] = lazy;
    }

    /// <inheritdoc />
    public bool Remove(string key)
    {
        ThrowIfDisposed();
        return _cache.TryRemove(key, out _);
    }

    /// <inheritdoc />
    public bool ContainsKey(string key)
    {
        ThrowIfDisposed();
        return _cache.ContainsKey(key);
    }

    /// <inheritdoc />
    public void Clear()
    {
        ThrowIfDisposed();
        _cache.Clear();
    }

    /// <summary>
    /// Called by the DI container at the end of the request scope.
    /// Disposes any cached values that implement IDisposable.
    /// </summary>
    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;

        foreach (var entry in _cache)
        {
            if (entry.Value.IsValueCreated && entry.Value.Value is IDisposable disposable)
            {
                disposable.Dispose();
            }
        }

        _cache.Clear();
    }

    /// <summary>
    /// Guards every public method against use after disposal.
    /// </summary>
    private void ThrowIfDisposed()
    {
        ObjectDisposedException.ThrowIf(_disposed, this);
    }
}













namespace YourProject.Caching;

/// <summary>
/// A cache that lives only for the duration of a single HTTP request.
/// </summary>
public interface IRequestCache
{
    /// <summary>
    /// Gets a cached value by key, or returns the default if not found.
    /// </summary>
    T? Get<T>(string key);

    /// <summary>
    /// Gets a cached value by key, or creates and caches it using the factory.
    /// </summary>
    T GetOrAdd<T>(string key, Func<T> factory);

    /// <summary>
    /// Gets a cached value by key, or creates and caches it using an async factory.
    /// </summary>
    Task<T> GetOrAddAsync<T>(string key, Func<Task<T>> factory);

    /// <summary>
    /// Adds or overwrites a value in the cache.
    /// </summary>
    void Set<T>(string key, T value);

    /// <summary>
    /// Removes a specific key from the cache.
    /// </summary>
    bool Remove(string key);

    /// <summary>
    /// Returns true if the key exists in the cache.
    /// </summary>
    bool ContainsKey(string key);

    /// <summary>
    /// Removes all entries from the cache.
    /// </summary>
    void Clear();
}