using Microsoft.Graph;
using Microsoft.Kiota.Abstractions;
using Moq;
using Newtonsoft.Json;
using System.Net;
using System.Net.Http;

[TestClass]
public class UserBatchRequestTests
{
    private Mock<IHttpProvider> _mockHttpProvider;
    private GraphServiceClient _graphClient;

    [TestInitialize]
    public void Setup()
    {
        _mockHttpProvider = new Mock<IHttpProvider>();
        
        // Build a fake batch response with one user result per step
        var batchResponse = new
        {
            responses = new[]
            {
                new
                {
                    id = "step_1",
                    status = 200,
                    body = new
                    {
                        value = new[]
                        {
                            new
                            {
                                givenName  = "John",
                                surname    = "Doe",
                                displayName = "John Doe",
                                mail       = "john.doe@example.com",
                                id         = "user-id-001"
                            }
                        }
                    }
                }
            }
        };

        var responseJson    = JsonConvert.SerializeObject(batchResponse);
        var httpResponse    = new HttpResponseMessage(HttpStatusCode.OK)
        {
            Content = new StringContent(responseJson,
                          System.Text.Encoding.UTF8,
                          "application/json")
        };

        // IHttpProvider.SendAsync returns the mocked HTTP response
        _mockHttpProvider
            .Setup(p => p.SendAsync(
                It.IsAny<HttpRequestMessage>(),
                It.IsAny<HttpCompletionOption>(),
                It.IsAny<CancellationToken>()))
            .ReturnsAsync(httpResponse);

        // Wire the mock provider into GraphServiceClient
        var mockAuthProvider = new Mock<IAuthenticationProvider>();
        _graphClient = new GraphServiceClient(mockAuthProvider.Object,
                                              _mockHttpProvider.Object);
    }

    [TestMethod]
    public async Task FetchUsersByMail_ReturnsMappedUsers()
    {
        // Arrange
        var fallbackIds = new List<string> { "john.doe@example.com" };
        var mailBatch   = new BatchRequestContent();
        var mailStepMap = new Dictionary<string, string>();

        foreach (var id in fallbackIds)
        {
            var stepId = mailBatch.AddBatchRequestStep(
                _graphClient.Users
                    .Request()
                    .Filter($"mail eq '{id}'")
                    .Top(1)
                    .Select(x => new { x.GivenName, x.Surname,
                                       x.DisplayName, x.Mail, x.Id })
                    .GetHttpRequestMessage());

            mailStepMap[stepId] = id;
        }

        // Act
        var batchResponse = await _graphClient
                                    .Batch
                                    .Request()
                                    .PostAsync(mailBatch);

        // Assert — each step resolves to the expected user
        foreach (var (stepId, mail) in mailStepMap)
        {
            var usersPage = await batchResponse
                                    .GetResponseByIdAsync<GraphServiceUsersCollectionResponse>(stepId);

            Assert.IsNotNull(usersPage?.Value,
                $"No user returned for mail '{mail}'");

            var user = usersPage.Value.First();
            Assert.AreEqual("john.doe@example.com", user.Mail);
            Assert.AreEqual("John",  user.GivenName);
            Assert.AreEqual("Doe",   user.Surname);
            Assert.AreEqual("John Doe", user.DisplayName);
            Assert.AreEqual("user-id-001", user.Id);
        }

        // Verify the HTTP provider was actually called once (the batch POST)
        _mockHttpProvider.Verify(
            p => p.SendAsync(
                It.IsAny<HttpRequestMessage>(),
                It.IsAny<HttpCompletionOption>(),
                It.IsAny<CancellationToken>()),
            Times.Once);
    }
}